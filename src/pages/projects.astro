---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const projects = [
  {
    id: "skillhub",
    name: "SkillHub Agent",
    tag: "Agent",
    desc: "把 Agent Skill 的研究与实践沉淀为可复用的技能集合。",
  },
  {
    id: "markdown",
    name: "Markdown Editor",
    tag: "Tools",
    desc: "一个属于自己的 Markdown 知识库工具，让笔记沉淀为长期可用的资产。",
  },
  {
    id: "poetry",
    name: "Poetry App",
    tag: "App",
    desc: "独立开发的小应用实验，详情待补充。",
  },
];
---

<Layout title={`Projects | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle="Projects" pageDesc="正在做的东西。">
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
      {projects.map(p => (
        <article
          id={p.id}
          class="border-border rounded-xl border p-5"
        >
          <h2 class="text-lg font-semibold">{p.name}</h2>
          <span
            class="bg-accent/10 text-accent mt-2 inline-block rounded-full px-2.5 py-0.5 text-xs font-medium"
          >
            {p.tag}
          </span>
          <p class="mt-2 text-sm opacity-75">{p.desc}</p>
        </article>
      ))}
    </div>
    <p class="mt-8 text-sm opacity-60 italic">
      项目详情持续补充中。
    </p>
  </Main>

  <Footer />
</Layout>
