---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { EXPLORE } from "@/data/explore";
import { useTranslations } from "@/i18n";
import config from "@/config";

// 分类索引页：/categories/ 列出全部 Explore 分类与文章数
const posts = await getCollection("posts", ({ data }) => !data.draft);
const sorted = getSortedPosts(posts);
const counts = new Map<string, number>();
for (const exp of EXPLORE) {
  counts.set(exp.id, sorted.filter(p => exp.cats.includes(p.data.category)).length);
}
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<Layout title={`${t.nav.categories} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.nav.categories} pageDesc="按主题浏览全部文章。">
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {EXPLORE.map(exp => (
        <li>
          <a
            href={`${baseRoot}categories/${exp.id}/`}
            class="block border border-skin-line rounded-xl p-5 hover:border-skin-accent transition"
          >
            <span class="text-lg font-semibold text-skin-accent">{exp.label}</span>
            <span class="ml-2 text-sm text-skin-muted">{counts.get(exp.id) ?? 0} 篇</span>
            <p class="mt-1 text-sm text-skin-base opacity-80">{exp.desc}</p>
          </a>
        </li>
      ))}
    </ul>
  </Main>

  <Footer />
</Layout>
