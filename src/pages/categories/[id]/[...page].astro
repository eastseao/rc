---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { EXPLORE, type ExploreItem } from "@/data/explore";
import { useTranslations } from "@/i18n";
import config from "@/config";

type PageProps = {
  exp: ExploreItem;
  pageNo: number;
  lastPage: number;
  total: number;
  pagePosts: CollectionEntry<"posts">[];
};

export const getStaticPaths = (async () => {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const sorted = getSortedPosts(posts);
  const perPage = config.posts.perPage;

  const paths: {
    params: Record<string, string | undefined>;
    props: PageProps;
  }[] = [];

  for (const exp of EXPLORE) {
    const filtered = sorted.filter(p => exp.cats.includes(p.data.category));
    const lastPage = Math.max(1, Math.ceil(filtered.length / perPage));
    for (let n = 1; n <= lastPage; n++) {
      paths.push({
        params: { id: exp.id, page: n === 1 ? undefined : String(n) },
        props: {
          exp,
          pageNo: n,
          lastPage,
          total: filtered.length,
          pagePosts: filtered.slice((n - 1) * perPage, n * perPage),
        },
      });
    }
  }
  return paths;
}) satisfies GetStaticPaths;

const { exp, pageNo, lastPage, total, pagePosts } = Astro.props as PageProps;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const base = `${baseRoot}categories/${exp.id}`;
const prevUrl = pageNo > 1 ? (pageNo === 2 ? base : `${base}/${pageNo - 1}`) : undefined;
const nextUrl = pageNo < lastPage ? `${base}/${pageNo + 1}` : undefined;
---

<Layout title={`${exp.label} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={exp.label} pageDesc={`${exp.desc} · 共 ${total} 篇`}>
    {pagePosts.length === 0 ? (
      <p>{exp.desc}，内容筹备中。</p>
    ) : (
      <ul>
        {pagePosts.map(data => (
          <Card {...data} />
        ))}
      </ul>
    )}
  </Main>

  {lastPage > 1 && (
    <nav
      class="mt-auto mb-8 flex justify-center gap-4"
      role="navigation"
      aria-label="Pagination Navigation"
    >
      <LinkButton
        disabled={!prevUrl}
        href={prevUrl ?? ""}
        class:list={["select-none", { "opacity-50": !prevUrl }]}
        aria-label={t.a11y.goToPreviousPage}
      >
        <IconArrowLeft class="inline-block rtl:rotate-180" />
        {t.pagination.prev}
      </LinkButton>
      {pageNo} / {lastPage}
      <LinkButton
        disabled={!nextUrl}
        href={nextUrl ?? ""}
        class:list={["select-none", { "opacity-50": !nextUrl }]}
        aria-label={t.a11y.goToNextPage}
      >
        {t.pagination.next}
        <IconArrowRight class="inline-block rtl:rotate-180" />
      </LinkButton>
    </nav>
  )}

  <Footer noMarginTop={lastPage > 1} />
</Layout>
